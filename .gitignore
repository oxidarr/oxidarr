/target
**/*.rs.bk
*.pdb

# sqlx offline query cache is committed on purpose; local db files are not
*.db
*.db-shm
*.db-wal

# dioxus
/dist
.dioxus/

# oxidarr-ui web bundle, copied here by scripts/build-ui.sh — see
# crates/oxidarr-prowl/src/ui.rs's module docs for why it lives inside
# oxidarr-prowl (not oxidarr-ui) rather than being covered by the root
# `/dist` above, which only anchors to the repo root, not this crate subdir
/crates/oxidarr-prowl/dist

# local working notes, never published
/.local/

# third-party indexer definitions, fetched not vendored
/.definitions/

# same reason: DEFAULT_DATA_DIR is ./data, and auto-update defaults to on,
# so `cargo run -p oxidarr-prowl` from the repo root fills data/definitions/
# with the same unlicensed, third-party .yml files
/data/

.DS_Store
